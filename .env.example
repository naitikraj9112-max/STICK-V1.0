# Copy this file to .env and supply your DeepSeek API key.
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
DATABASE_TIMEOUT_SECONDS=8
MIN_NEW_SCENE_SECONDS=15
PRESENTATION_PORT=8001
PRESENTATION_LANGUAGE=en
PPT_MASTER_ROOT=/absolute/path/to/ppt-master
# Optional manual/demo workspace. Browser sessions use PRESENTATION_ARTIFACT_DIR/<session_id>/ppt_master/
PPT_MASTER_WORKSPACE=/absolute/path/to/an-initialized-ppt-master-project
PRESENTATION_ARTIFACT_DIR=artifacts
GENERATION_MAX_CORRECTIONS=1
GENERATION_DEBOUNCE_SECONDS=0.5

# Optional: Image generation providers (priority: Pollinations -> Cloudflare Worker -> Gemini).
POLLINATIONS_API_KEY=
CF_WORKER_URL=

# Optional Gemini multimedia (video narration, TTS, and image fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional Sarvam Saaras STT and Bulbul TTS.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_WS_PORT=8765

# Legacy only; not used by Stick.
GROQ_API_KEY=

MEDIA_MAX_CONCURRENCY=4
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRIES=2
MEDIA_RETRY_BACKOFF_SECONDS=0.75

# Video generation remains off until a supported narration TTS provider is configured.
VIDEO_ENABLED=false
VIDEO_OUTPUT_FORMAT=mp4
FFMPEG_PATH=ffmpeg

TTS_VOICE=Kore
TTS_SPEED=1.0
