# Copy this file to .env and supply your key when enabling OpenAI Realtime.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
DATABASE_TIMEOUT_SECONDS=8
HTTP_TIMEOUT_SECONDS=30
RECONNECT_MAX_ATTEMPTS=3
MIN_NEW_SCENE_SECONDS=15
REALTIME_SILENCE_MS=400
REALTIME_TOOL_CHOICE=required
PRESENTATION_PORT=8001
PPT_MASTER_ROOT=/absolute/path/to/ppt-master
# Optional manual/demo workspace. Browser sessions use PRESENTATION_ARTIFACT_DIR/<session_id>/ppt_master/
PPT_MASTER_WORKSPACE=/absolute/path/to/an-initialized-ppt-master-project
PRESENTATION_ARTIFACT_DIR=artifacts
GENERATION_MAX_CORRECTIONS=1
GENERATION_DEBOUNCE_SECONDS=0.5

# Optional Gemini multimedia (video/image/TTS). Missing key degrades multimedia only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

MEDIA_MAX_CONCURRENCY=4
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRIES=2
MEDIA_RETRY_BACKOFF_SECONDS=0.75

VIDEO_ENABLED=true
VIDEO_OUTPUT_FORMAT=mp4
FFMPEG_PATH=ffmpeg

TTS_VOICE=Kore
TTS_SPEED=1.0
